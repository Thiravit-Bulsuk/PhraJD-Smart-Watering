MQTT_URL=mqtts://your-deployment.ala.us-east-1.emqxsl.com:8883
MQTT_USERNAME=your-mqtt-user
MQTT_PASSWORD=your-mqtt-password
# Subscribe-only EMQX account; sent to browsers so they read status directly over WebSocket
MQTT_VIEW_USERNAME=your-view-only-user
MQTT_VIEW_PASSWORD=your-view-only-password
# Optional, defaults to wss://<host of MQTT_URL>:8084/mqtt
# MQTT_WS_URL=wss://your-deployment.ala.us-east-1.emqxsl.com:8084/mqtt
CONTROL_PASSWORD=change-me
PORT=4173
